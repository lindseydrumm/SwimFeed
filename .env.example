 # Swim Live - Environment Variables Template                                                           
 # Copy this file to .env and customize for your environment                                            
                                                                                                        
 # Database Configuration (Docker uses 'db' as hostname, local uses 'localhost')                        
 DATABASE_URL=postgresql+psycopg2://dev:dev@db:5432/swimlive                                            
                                                                                                        
 # Scraper Configuration                                                                                
 FEED_URL=https://swimswam.com/feed/                                                                    
                                                                                                        
 # API URL (use 'backend' for Docker, 'localhost:8000' for local)                                       
 API_URL=http://backend:8000/ingest/article                                                             
                                                                                                        
 # Security
 # API key for /ingest/* endpoints (optional for local dev; set in production)
 INGEST_API_KEY=
 # Comma-separated CORS origins (add production URL in deployed env)
 CORS_ORIGINS=http://localhost:5173

 # Application Settings
 APP_NAME=Swim Live Backend
 DEBUG=true

 CLERK_JWKS_URL=https://vocal-locust-47.clerk.accounts.dev/.well-known/jwks.json
